<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    AI-GENERATED CODE (partial): Claude (Anthropic) set the publisher, publisher display name,
    description and version, and removed the unused phone identity and systemAIModels capability,
    following SecretLetter's manifest.
    Publisher is the exact name the Artifact Signing certificate (account edwest19, profile
    CodeSigning-Apps) signs as. It is case-sensitive ("S=ny") and checked by ReleaseRulesTests.
    Version is Directory.Build.props' Version plus ".0".
    Name (the package name) stays the same: the reset script finds SecretLead by it.
    SecretLead is a project built with AI-generated code; see README.md.
  -->
  <Identity
    Name="D3B25905-54E0-4737-BC59-F1CFA9E25E2B"
    Publisher="CN=Edwin West, O=Edwin West, L=Huntington, S=ny, C=US"
    Version="0.2.0.0" />

  <Properties>
    <DisplayName>SecretLead</DisplayName>
    <PublisherDisplayName>Edwin West</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="SecretLead"
        Description="Builds printable lists from CSV files, entirely on your PC"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Only runFullTrust: no network, device or AI capabilities (enforced by RepositoryRulesTests). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
